# === Database ===
POSTGRES_URL=postgresql+asyncpg://raguser:changeme@localhost:5432/rag_db
MILVUS_URI=http://localhost:19530
VECTOR_STORE_BACKEND=milvus

# === LLM API ===
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-your-deepseek-api-key
LLM_MODEL_NAME=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com

# === Models (local paths or HuggingFace IDs) ===
BGE_M3_MODEL_PATH=BAAI/bge-m3
RERANKER_MODEL_PATH=BAAI/bge-reranker-v2-m3
EMBEDDING_PROVIDER=remote
EMBEDDING_BASE_URL=http://localhost:8000
EMBEDDING_ENDPOINT=/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=30
RERANKER_PROVIDER=remote
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANKER_BASE_URL=http://localhost:8001
RERANKER_ENDPOINT=/rerank
RERANKER_API_KEY=
RERANKER_TIMEOUT_SECONDS=30
REQUEST_RETRY_ATTEMPTS=2
REQUEST_RETRY_BACKOFF_SECONDS=0.25

# === Retrieval Parameters ===
DENSE_TOP_K=50
SPARSE_TOP_K=50
RRF_K=60
RERANK_TOP_N=20
FINAL_TOP_K=5
TIME_DECAY_ALPHA=0.01
TIME_DECAY_LAMBDA=0.3

# === OCR ===
USE_OCR=true
OCR_LANG=ch

# === Paths ===
UPLOAD_DIR=./data/uploads
IMAGE_DIR=./data/images
MAX_UPLOAD_SIZE_BYTES=52428800

# === Server ===
API_HOST=0.0.0.0
API_PORT=8002
API_CLIENT_URL=http://127.0.0.1:8002
GRADIO_PORT=7860
